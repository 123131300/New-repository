function StyleEditor({ content, set, pickedKey, setPickedKey }){
  const s=(content.styles&&content.styles[pickedKey])||{};
  const setStyle=(patch)=>{ const styles={...(content.styles||{}), [pickedKey]:{...(content.styles?.[pickedKey]||{}), ...patch}}; set({ ...content, styles }); };
  const reset=()=>{ const styles={...(content.styles||{})}; delete styles[pickedKey]; set({ ...content, styles }); };
  const keys=listKeys(content);
  // FIX: lineHeight slider работает и с числами, и со строками вида '28px'
  const lhVal = useMemo(()=>{
    const v = s.lineHeight; if (v==null) return 1.2; const num = Number(v); return Number.isFinite(num) && num>0 ? num : 1.2;
  }, [s.lineHeight]);
  return (
    <div>
      <div className="mb-3"><Label>Элементы на странице</Label><div className="flex flex-wrap gap-2">{keys.map(({key,label})=>(<button key={key} onClick={()=>setPickedKey(key)} className={`px-2 py-1 rounded text-xs ${pickedKey===key?"bg-emerald-700":"bg-neutral-700"}`}>{label}</button>))}</div></div>
      {!pickedKey && <div className="text-sm text:white/60 mb-4">Выбери элемент выше или кликни по тексту на странице с включённой «Пипеткой».</div>}
      {pickedKey && (<>
        <div className="text-xs text-white/50 mb-2">Цель: {pickedKey}</div>
        <div className="mb-4"><Label>Размер шрифта (px)</Label><div className="flex items-center gap-3"><input type="range" min={12} max={128} step={1} value={s.fontSize??18} onChange={(e)=>setStyle({fontSize:Number(e.target.value)})}/><input type="number" className="w-20 bg-neutral-800/70 rounded px-2 py-1" value={s.fontSize??18} onChange={(e)=>setStyle({fontSize:Number(e.target.value||18)})}/></div></div>
        <div className="mb-4"><Label>Межстрочный интервал</Label><div className="flex items-center gap-3"><input type="range" min={0.8} max={2} step={0.05} value={lhVal} onChange={(e)=>setStyle({lineHeight:Number(e.target.value)})}/><input type="text" className="w-24 bg-neutral-800/70 rounded px-2 py-1" value={s.lineHeight??"1.2"} onChange={(e)=>setStyle({lineHeight:e.target.value})}/><div className="text-xs text-white/40">число или px (например, 1.4 или 28px)</div></div></div>
        <div className="mb-4"><Label>Начертание</Label><select className="bg-neutral-800/70 rounded px-2 py-2" value={s.weight??400} onChange={(e)=>setStyle({weight:Number(e.target.value)})}><option value={300}>Light (300)</option><option value={400}>Regular (400)</option><option value={600}>SemiBold (600)</option><option value={700}>Bold (700)</option><option value={800}>ExtraBold (800)</option></select></div>
        <div className="mb-4"><Label>Выравнивание</Label><div className="flex gap-2">{[["left","Слева"],["center","По центру"],["right","Справа"]].map(([val,label])=> (<button key={val} onClick={()=>setStyle({align:val})} className={`px-3 py-1 rounded ${s.align===val?"bg-emerald-700":"bg-neutral-700"}`}>{label}</button>))}</div></div>
        <div className="flex gap-2"><button className="px-3 py-1 rounded bg-neutral-700" onClick={reset}>Сбросить стиль</button></div>
      </>)}
    </div>
  );
}

function QuizEditor({ content, set }){
  const q=content.quiz;
  const updateStep=(i, patch)=>{ const steps=[...q.steps]; steps[i]={...steps[i], ...patch}; set({ ...content, quiz:{...q, steps} }); };
  const addChoice=(i)=>updateStep(i,{ options:[...(q.steps[i].options||[]), "Новый вариант"] });
  const addStep = (type) => set({ ...content, quiz:{...q, steps:[...q.steps, type==="choice"?{type:"choice", label:"Вопрос", options:["Вариант 1"]}:{type, label:"Вопрос", placeholder:""}] } });
  const delStep = (i) => set({ ...content, quiz:{...q, steps:q.steps.filter((_,idx)=>idx!==i)} });
  return (
    <div>
      <Label>Заголовок квиза</Label>
      <input value={q.title} onChange={(e)=>set({ ...content, quiz:{...q, title:e.target.value} })} className="w-full bg-neutral-800/70 rounded px-2 py-2 mb-2"/>
      <div className="flex gap-2 mb-2">
        <button className="px-2 py-1 bg-neutral-700 rounded text-xs" onClick={()=>addStep("choice")}>Добавить выбор</button>
        <button className="px-2 py-1 bg-neutral-700 rounded text-xs" onClick={()=>addStep("text")}>Добавить текст</button>
        <button className="px-2 py-1 bg-neutral-700 rounded text-xs" onClick={()=>addStep("textarea")}>Добавить многострочный</button>
      </div>
      {q.steps.map((s, i)=> (
        <div key={i} className="mb-3 p-2 rounded bg:white/5">
          <div className="grid grid-cols-12 gap-2 items-center mb-2">
            <div className="col-span-10"><input className="w-full bg-neutral-800/70 rounded px-2 py-1" value={s.label} onChange={(e)=>updateStep(i,{label:e.target.value})}/></div>
            <div className="col-span-2 text-right"><span className="text-xs px-2 py-1 rounded bg-neutral-700">{s.type}</span></div>
          </div>
          {s.type==="choice" && (
            <div>
              {(s.options||[]).map((opt, oi)=> (
                <div key={oi} className="flex gap-2 mb-1 items-center">
                  <input className="flex-1 bg-neutral-800/70 rounded px-2 py-1" value={opt} onChange={(e)=>{ const options=[...(s.options||[])]; options[oi]=e.target.value; updateStep(i,{options}); }}/>
                  <button className="px-2 py-1 text-xs bg-neutral-700 rounded" onClick={()=>{ const options=[...(s.options||[])]; options.splice(oi,1); updateStep(i,{options}); }}>X</button>
                </div>
              ))}
              <button className="text-xs px-2 py-1 bg-neutral-700 rounded" onClick={()=>addChoice(i)}>Добавить вариант</button>
            </div>
          )}
          {s.type!=="choice" && (
            <div>
              <Label>Placeholder</Label>
              <input className="w-full bg-neutral-800/70 rounded px-2 py-1" value={s.placeholder||""} onChange={(e)=>updateStep(i,{placeholder:e.target.value})}/>
            </div>
          )}
          <div className="mt-2 text-right"><button className="px-2 py-1 text-xs bg-neutral-700 rounded" onClick={()=>delStep(i)}>Удалить шаг</button></div>
        </div>
      ))}
      <div className="grid grid-cols-12 gap-2">
        <div className="col-span-4"><Label>Кнопка Назад</Label><input className="w-full bg-neutral-800/70 rounded px-2 py-1" value={q.labels.back} onChange={(e)=>set({ ...content, quiz:{...q, labels:{...q.labels, back:e.target.value}} })}/></div>
        <div className="col-span-4"><Label>Кнопка Далее</Label><input className="w-full bg-neutral-800/70 rounded px-2 py-1" value={q.labels.next} onChange={(e)=>set({ ...content, quiz:{...q, labels:{...q.labels, next:e.target.value}} })}/></div>
        <div className="col-span-4"><Label>Кнопка Отправить</Label><input className="w-full bg-neutral-800/70 rounded px-2 py-1" value={q.labels.submit} onChange={(e)=>set({ ...content, quiz:{...q, labels:{...q.labels, submit:e.target.value}} })}/></div>
      </div>
    </div>
  );
}

