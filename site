function Quiz({ content }){
  const [i, setI] = useState(0);
  const [answers, setAnswers] = useState({});
  const step = content.quiz.steps[i];
  const onNext = () => setI((x)=> Math.min(x+1, content.quiz.steps.length-1));
  const onBack = () => setI((x)=> Math.max(x-1, 0));
  const onSubmit = () => setI(content.quiz.steps.length);
  return (
    <Section id="form">
      <div className="max-w-3xl mx-auto px-4 py-12">
        <div className="text-center text-2xl font-bold mb-4">{content.quiz.title}</div>
        {i < content.quiz.steps.length ? (
          <div className="rounded-xl border border-white/10 p-4 bg-neutral-800/30">
            <div className="mb-3 font-semibold">{step.label}</div>
            {step.type==="choice" && (
              <div className="grid sm:grid-cols-2 gap-2">
                {(step.options||[]).map((opt, oi)=> (
                  <label key={oi} className={`px-3 py-2 rounded-lg border ${answers[i]===opt?"border-emerald-500 bg-emerald-500/10":"border-white/10"}`}>
                    <input type="radio" name={`s${i}`} className="mr-2" checked={answers[i]===opt} onChange={()=>setAnswers(a=>({...a,[i]:opt}))}/>
                    {opt}
                  </label>
                ))}
              </div>
            )}
            {step.type==="text" && (
              <input className="w-full bg-neutral-800/70 rounded px-3 py-2" placeholder={step.placeholder||""} value={answers[i]||""} onChange={(e)=>setAnswers(a=>({...a,[i]:e.target.value}))}/>
            )}
            {step.type==="textarea" && (
              <textarea className="w-full bg-neutral-800/70 rounded px-3 py-2" rows={5} placeholder={step.placeholder||""} value={answers[i]||""} onChange={(e)=>setAnswers(a=>({...a,[i]:e.target.value}))}/>
            )}
            <div className="mt-4 flex justify-between">
              <button onClick={onBack} disabled={i===0} className={`px-4 py-2 rounded ${i===0?"bg-neutral-700 text-white/40":"bg-neutral-700 hover:bg-neutral-600"}`}>{content.quiz.labels.back}</button>
              {i===content.quiz.steps.length-1 ? (
                <button onClick={onSubmit} className="px-4 py-2 rounded bg-emerald-600 hover:bg-emerald-500">{content.quiz.labels.submit}</button>
              ) : (
                <button onClick={onNext} className="px-4 py-2 rounded bg-emerald-600 hover:bg-emerald-500">{content.quiz.labels.next}</button>
              )}
            </div>
          </div>
        ) : (
          <div className="rounded-xl border border-white/10 p-6 bg-neutral-800/30 text-center">
            <div className="text-2xl font-bold mb-2">{content.quiz.labels.doneTitle||"Готово!"}</div>
            <div className="text-white/70 mb-4">{content.quiz.labels.doneText||"Ответы сохранены."}</div>
            <pre className="text-left text-xs bg-black/30 rounded p-3 overflow-auto">{JSON.stringify(answers, null, 2)}</pre>
          </div>
        )}
      </div>
    </Section>
  );
}

