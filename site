        {/* Editor */}
        <div className="rounded-xl border border-white/10 overflow-hidden">
          <div className="flex flex-wrap gap-1 p-2 bg-neutral-900/80 border-b border-white/10 sticky top-16 z-40">
            {tabs.map(t => (
              <button key={t.k} onClick={()=>setTab(t.k)} className={`px-3 py-1.5 rounded ${tab===t.k?"bg-emerald-700":"bg-neutral-700"}`}>{t.t}</button>
            ))}
          </div>
          <div className="p-3 bg-neutral-900/60 max-h-[80vh] overflow-auto">
            {tabs.find(t=>t.k===tab)?.c}
