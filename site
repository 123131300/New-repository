        <div className="flex items-center gap-2">
          <button onClick={()=>setPipette(p=>!p)} className={`px-3 py-1.5 rounded-lg border ${pipette?"border-emerald-500 bg-emerald-500/10":"border-white/10 bg-neutral-800/50"}`}>Пипетка {pipette?"вкл":"выкл"}</button>
          <button onClick={()=>{ localStorage.removeItem(LS_KEY); set(DEFAULT_CONTENT); }} className="px-3 py-1.5 rounded-lg border border-white/10 bg-neutral-800/50">Сбросить контент</button>
        </div>
      </div>

      {/* Preview + Editor */}
      <div className="max-w-[1400px] mx-auto px-4 pb-16 grid lg:grid-cols-[1fr_420px] gap-6">
        {/* Preview */}
        <div ref={previewRef} className="rounded-xl border border-white/10 overflow-hidden bg-gradient-to-b from-neutral-900 via-neutral-900 to-neutral-950">
          <Hero content={content} />
          <Manifest content={content} />
          <Audience content={content} />
          <Author content={content} />
          <Program content={content} />
          <KitPlaceholder />
          <Gear content={content} />
          <Cases content={content} />
          <Community content={content} />
