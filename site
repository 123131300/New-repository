// ---------- Мини‑смоук‑тесты ----------
function smokeTests(content, tabs){
  const errs=[];
  if (typeof ManifestEditor !== 'function') errs.push('ManifestEditor missing');
  if (!tabs.some(t=>t.k==='manifest')) errs.push('Tab "manifest" отсутствует');
  if (!content?.manifest || typeof content.manifest.title !== 'string') errs.push('content.manifest: структура некорректна');
  if (!Array.isArray(content?.cases?.items)) errs.push('content.cases.items: ожидался массив');
  return errs;
}

// ---------- Главный компонент ----------
export default function App(){
  const [content, setContent] = useState(load());
  const set = (c) => { setContent(c); save(c); };
  const [tab, setTab] = useState("hero");
  const [pipette, setPipette] = useState(false);
  const [pickedKey, setPickedKey] = useState("");
  const previewRef = useRef(null);

  useEffect(()=>{ const h = (e)=>{ if(!pipette) return; const el = e.target.closest?.('[data-k]'); if(el){ const key = el.getAttribute('data-k'); if(key){ setPickedKey(key); setPipette(false); } } }; const node = previewRef.current; node?.addEventListener('click', h); return ()=>node?.removeEventListener('click', h); },[pipette]);

  const tabs = [
    {k:"nav", t:"Навигация", c:<NavEditor content={content} set={set}/>},
    {k:"images", t:"Изображения", c:<ImagesEditor content={content} set={set}/>},
    {k:"hero", t:"Hero", c:<HeroEditor content={content} set={set}/>},
    {k:"manifest", t:"Манифест", c:<ManifestEditor content={content} set={set}/>},
    {k:"audience", t:"Для кого", c:<AudienceEditor content={content} set={set}/>},
    {k:"author", t:"Автор", c:<AuthorEditor content={content} set={set}/>},
    {k:"program", t:"Программа", c:<ProgramEditor content={content} set={set}/>},
    {k:"gear", t:"Снаряжение", c:<GearEditor content={content} set={set}/>},
    {k:"cases", t:"Кейсы", c:<CasesEditor content={content} set={set}/>},
    {k:"community", t:"Комьюнити", c:<CommunityEditor content={content} set={set}/>},
    {k:"contract", t:"Контракт", c:<ContractEditor content={content} set={set}/>},
    {k:"cta", t:"CTA", c:<CTAEditor content={content} set={set}/>},
    {k:"quiz", t:"Квиз", c:<QuizEditor content={content} set={set}/>},
    {k:"style", t:"Стиль", c:<StyleEditor content={content} set={set} pickedKey={pickedKey} setPickedKey={setPickedKey}/>},
    {k:"data", t:"Данные", c:<DataEditor content={content} set={set}/>},
  ];

  // Запускаем мини‑смоук‑тесты один раз при инициализации
  useEffect(()=>{
    const errs = smokeTests(content, tabs);
    if (errs.length) {
      console.warn('[SMOKE TESTS] Fail:', errs);
    } else {
      console.log('[SMOKE TESTS] OK');
    }
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  return (
    <div className="min-h-screen bg-neutral-900 text-white scroll-smooth">
      <Header content={content} />

      <div className="max-w-6xl mx-auto px-4 pt-24 pb-8 flex justify-between items-center">
